// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Story {
  storyId     String   @id @default(cuid())
  title       String
  description String
  content     String
  images      String[]
}

model PreviousEvents {
  previousEventId  String   @id @default(cuid())
  eventCity        String
  eventTitle       String
  eventDate        DateTime
  eventDescription String
  eventImages      String[]
}

model UpcomingEvents {
  upcomingEventId  String   @id @default(cuid())
  eventCity        String
  eventTitle       String
  eventDate        DateTime
  eventDescription String
  eventImages      String[]
}
